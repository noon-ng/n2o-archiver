<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The app is signed ad hoc and has no Team ID, so with library validation
         it could not load plugins signed with a Developer ID (see
         NAPluginManager). Hardened runtime still ignores DYLD_* variables. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
